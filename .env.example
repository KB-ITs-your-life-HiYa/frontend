# 로컬 환경변수 템플릿.
#
# 【쓰는 법】
#   cp .env.example .env
#   값을 채운 뒤 expo 를 재시작한다. (.env 는 gitignore 됨)
#
# ⚠️ EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 포함된다.
#    누구나 앱을 뜯어보면 읽을 수 있으므로, 서버 전용 비밀키(service_role 등)는
#    여기에 절대 넣지 말 것. 백엔드에만 둔다.

# 백엔드 API 주소
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (src/services/supabase.ts 에서 사용)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
